{
  "expo": {
    "name": "Internal Operations Hub",
    "slug": "hr-mobile",
    "scheme": "eurisko-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eurisko.hub"
    },
    "android": {
      "package": "com.eurisko.hub",
      "scheme": "eurisko-hub",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "de134d2c-01ad-451b-a1f1-52d4b47ea51d"
      }
    },
    "owner": "francois-maarbess",
    "plugins": [
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "webClientId": "804630899699-d6eceuaat3io3p1f65ihvsejfgpnatcn.apps.googleusercontent.com",
          "iosUrlScheme": "com.googleusercontent.apps.804630899699-d6eceuaat3io3p1f65ihvsejfgpnatcn",
          "profileImageSize": 120
        }
      ]
    ]
  }
}
